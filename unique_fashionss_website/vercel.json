{
  "services": {
    "backend": {
      "root": "unique_fashionss_website/backend",
      "framework": "express"
    },
    "frontend": {
      "root": "unique_fashionss_website/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}